---
import type { YogaClass } from '../types';
import Icon from './Icon.astro';
import { url } from '../utils/url';

interface Props {
  item: YogaClass;
}

const { item } = Astro.props;
---

<a class="class-card" href={url(item.href ?? '/#schedule')}>
  <div class="class-card__media">
    <img src={url(item.image.src)} alt={item.image.alt} width="900" height="720" loading="lazy" decoding="async" />
    <span class="tag tag--glass">{item.level}</span>
  </div>
  <div class="class-card__body">
    <div>
      <h3>{item.title}</h3>
      <p>{item.description}</p>
      <div class="class-card__meta">
        <span><Icon name="clock" size={14} /><span class="sr-only">Duration:</span>{item.duration}</span>
        <span><Icon name="level" size={14} /><span class="sr-only">Intensity:</span>{item.intensity}</span>
      </div>
    </div>
    <span class="class-card__go" aria-hidden="true"><Icon name="arrow-up" size={16} /></span>
  </div>
</a>
