---
import { newsletter } from '../data/home';
import { site } from '../config/site';

interface Props {
  /** Remove the top padding when it follows another white section. */
  flush?: boolean;
}

const { flush = true } = Astro.props;
const action = site.forms.newsletterAction;
---

<section class:list={['section', { 'section--flush-top': flush }]} aria-labelledby="news-title">
  <div class="container">
    <div class="newsletter">
      <div>
        <h2 id="news-title">{newsletter.title}</h2>
        <p>{newsletter.intro}</p>
      </div>
      <div>
        <form class="subscribe" method={action ? 'post' : 'get'} action={action || undefined} data-newsletter data-demo={action ? undefined : 'true'} novalidate>
          <label for="newsletter-email" class="sr-only">Email address</label>
          <input
            id="newsletter-email"
            name="email"
            type="email"
            placeholder={newsletter.placeholder}
            autocomplete="email"
            required
            aria-describedby="newsletter-msg"
          />
          <button class="btn btn--dark" type="submit">{newsletter.buttonLabel}</button>
        </form>
        <p class="subscribe__msg" id="newsletter-msg" aria-live="polite"></p>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-newsletter]').forEach((form) => {
    const input = form.querySelector<HTMLInputElement>('input[type="email"]');
    const msg = document.getElementById(input?.getAttribute('aria-describedby') ?? '');
    if (!input || !msg) return;

    form.addEventListener('submit', (event) => {
      if (!input.value || !input.checkValidity()) {
        event.preventDefault();
        input.setAttribute('aria-invalid', 'true');
        msg.textContent = 'Enter a valid email address, like name@example.com.';
        input.focus();
        return;
      }
      input.removeAttribute('aria-invalid');
      // No endpoint configured: this is the theme demo, so nothing is sent.
      if (form.dataset.demo) {
        event.preventDefault();
        msg.textContent = 'Thanks! This demo form is not connected yet, so nothing was sent.';
        input.value = '';
      }
    });
  });
</script>
