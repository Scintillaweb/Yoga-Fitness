---
import Button from './Button.astro';
import { hero } from '../data/home';
import { url } from '../utils/url';
---

<div class="hero-wrap">
  <section class="hero" aria-labelledby="hero-title">
    <img
      class="hero__bg"
      src={url(hero.image.src)}
      alt={hero.image.alt}
      width="2200"
      height="1400"
      loading="eager"
      fetchpriority="high"
    />
    <div class="container hero__inner">
      {hero.proof && (
        <div class="hero__proof">
          <div class="avatars">
            {hero.proof.avatars.map((avatar) => (
              <img src={url(avatar.src)} alt={avatar.alt} width="36" height="36" loading="eager" />
            ))}
          </div>
          <p>{hero.proof.label}<strong>{hero.proof.value}</strong></p>
        </div>
      )}
      <h1 class="hero__title" id="hero-title">
        {hero.title.map((word, i) => (
          <>
            {i > 0 && <span class="slash" aria-hidden="true" />}{' '}
            <span class:list={{ serif: word.serif }}>{word.text}</span>{' '}
          </>
        ))}
      </h1>
      <div class="hero__foot">
        <p>{hero.description}</p>
        <Button href={hero.cta.href} variant="glass">{hero.cta.label}</Button>
      </div>
    </div>
  </section>
</div>
