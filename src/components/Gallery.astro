---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { gallery } from '../data/home';
import { site } from '../config/site';
import { url } from '../utils/url';
import type { GalleryImage } from '../types';

const images: GalleryImage[] = gallery.images;

const noteLink = site.socials.find((s) => s.label.toLowerCase() === 'instagram') ?? site.socials[0];
---

<section class="section section--mist" id="gallery" aria-labelledby="gallery-title">
  <div class="container">
    <SectionHeading id="gallery-title" title={gallery.title} intro={gallery.intro} />
    <div class="gallery">
      {images.map((image, i) => {
        const img = (
          <img
            src={url(image.src)}
            alt={image.alt}
            width={i === 0 ? 900 : 1000}
            height={i === 0 ? 1160 : 700}
            loading="lazy"
            decoding="async"
          />
        );
        return (
          <figure>
            {image.href ? <a href={url(image.href)}>{img}</a> : img}
            {image.caption && <figcaption class="tag tag--glass">{image.caption}</figcaption>}
          </figure>
        );
      })}
      {gallery.note && (
        <div class="gallery__note">
          <p>{gallery.note}</p>
          {noteLink && (
            <a class="link-arrow" href={noteLink.href}>
              {gallery.noteLinkLabel}<Icon name="arrow-up" size={14} />
            </a>
          )}
        </div>
      )}
    </div>
  </div>
</section>
