---
import type { HeroWord, ImageData } from '../types';
import Breadcrumbs from './Breadcrumbs.astro';
import { url } from '../utils/url';

export interface PageHeroProps {
  image: ImageData;
  /** Plain title, used when `words` is not provided. */
  title: string;
  /** Display-style title: words separated by slashes, optional serif words. */
  words?: HeroWord[];
  eyebrow?: string;
  lead?: string;
  breadcrumbs?: Array<{ name: string; href: string }>;
  /** Full-height, centered variant (used by the 404 page). */
  full?: boolean;
  imagePosition?: string;
}

type Props = PageHeroProps;

const { image, title, words, eyebrow, lead, breadcrumbs, full = false, imagePosition = 'center' } = Astro.props;
---

<div class="page-hero-wrap">
  <header class:list={['page-hero', { 'page-hero--full': full }]}>
    <img
      class="page-hero__bg"
      src={url(image.src)}
      alt={image.alt}
      width="2000"
      height="1125"
      loading="eager"
      fetchpriority="high"
      style={`object-position:${imagePosition}`}
    />
    <div class="container page-hero__inner">
      {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
      {eyebrow && <p class="page-hero__eyebrow">{eyebrow}</p>}
      {words ? (
        <h1 class="page-hero__title">
          {words.map((word, i) => (
            <>
              {i > 0 && <span class="slash" aria-hidden="true" />}{' '}
              <span class:list={{ serif: word.serif }}>{word.text}</span>{' '}
            </>
          ))}
        </h1>
      ) : (
        <h1 class="page-hero__title page-hero__title--plain">{title}</h1>
      )}
      {lead && <p class="page-hero__lead">{lead}</p>}
      <slot />
    </div>
  </header>
</div>
