---
import type { PricingPlan } from '../types';
import Icon from './Icon.astro';
import Button from './Button.astro';
import { pricing } from '../data/pricing';

interface Props {
  plan: PricingPlan;
}

const { plan } = Astro.props;
---

<article class:list={['plan', { 'plan--featured': plan.featured }]}>
  <div class="plan__top">
    <h3>{plan.name}</h3>
    {plan.badge && <span class="tag">{plan.badge}</span>}
  </div>
  <p class="plan__desc">{plan.description}</p>
  <div class="plan__price">
    <span class="plan__amount" data-monthly={plan.monthlyPrice} data-yearly={plan.yearlyPrice}>{pricing.currency}{plan.monthlyPrice}</span>
    <span class="plan__per">{pricing.monthlyLabel}</span>
  </div>
  <ul class="plan__list">
    {plan.features.map((feature) => (
      <li><Icon name="check" size={16} />{feature}</li>
    ))}
  </ul>
  <Button href={plan.ctaUrl} variant={plan.featured ? 'light' : 'line'}>{plan.ctaLabel}</Button>
</article>
