---
import { lines } from '../utils/format';

interface Props {
  title: string;
  intro?: string;
  /** id for the <h2>, used by the section's aria-labelledby. */
  id?: string;
  center?: boolean;
}

const { title, intro, id, center = false } = Astro.props;
const titleLines = lines(title);
---

<div class:list={['section-head', { 'section-head--center': center }]}>
  <div>
    <h2 id={id}>{titleLines.map((line, i) => (<>{i > 0 && <br />}{line}</>))}</h2>
    {intro && <p>{intro}</p>}
  </div>
  <slot />
</div>
