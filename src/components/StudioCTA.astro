---
import Button from './Button.astro';

interface Props {
  title?: string;
  intro?: string;
  /** Remove the top padding when it follows another white section. */
  flush?: boolean;
}

const {
  title = 'Ready to Roll Out Your Mat?',
  flush = true,
  intro = 'Try any beginner-friendly class free, or tell us what you are looking for and we will suggest the right place to start.',
} = Astro.props;
---

<section class:list={['section', { 'section--flush-top': flush }]} aria-labelledby="studio-cta-title">
  <div class="container">
    <div class="newsletter">
      <div>
        <h2 id="studio-cta-title">{title}</h2>
        <p>{intro}</p>
      </div>
      <div class="newsletter__actions">
        <Button href="/#pricing">Book a Free Class</Button>
        <Button href="/contact" variant="line">Contact the Studio</Button>
      </div>
    </div>
  </div>
</section>
