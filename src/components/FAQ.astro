---
import Button from './Button.astro';
import Icon from './Icon.astro';
import { faqs } from '../data/faq';
import { faqSection } from '../data/home';
---

<section class="section section--mist" id="faq" aria-labelledby="faq-title">
  <div class="container faq">
    <div class="faq__intro">
      <h2 id="faq-title">{faqSection.title}</h2>
      <p>{faqSection.intro}</p>
      {faqSection.cta && <Button href={faqSection.cta.href}>{faqSection.cta.label}</Button>}
    </div>
    <div class="faq__list">
      {faqs.map((item, i) => (
        <details open={i === 0}>
          <summary>{item.question}<span class="faq__icon" aria-hidden="true"><Icon name="plus" size={14} /></span></summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
