---
import Button from './Button.astro';
import Icon from './Icon.astro';
import { cta } from '../data/home';
import { site } from '../config/site';
import { url } from '../utils/url';
import { lines, phoneText } from '../utils/format';

interface Props {
  /** Show the email + address row (hide it on pages that already list them). */
  showContact?: boolean;
}

const { showContact = true } = Astro.props;
const { contact } = site;
const titleParts = lines(cta.title).map((line) => line.split('{lotus}'));
---

<section class:list={['cta', { 'cta--compact': !showContact }]} id="get-started" aria-labelledby="cta-title">
  <img class="cta__bg" src={url(cta.image.src)} alt={cta.image.alt} width="2000" height="1333" loading="lazy" decoding="async" />
  <div class="container cta__head">
    <h2 id="cta-title">
      {titleParts.map((parts, i) => (
        <>
          {i > 0 && <br />}
          {parts.map((part, j) => (
            <>
              {j > 0 && <span class="lotus-chip" aria-hidden="true"><Icon name="lotus" size={24} /></span>}
              {part}
            </>
          ))}
        </>
      ))}
    </h2>
    <p>{cta.intro}</p>
    <Button href={cta.button.href}>{cta.button.label}</Button>
  </div>
  {showContact && (
    <div class="container contact">
      <div>
        <p class="contact__label">{cta.contactLabel}</p>
        <a class="contact__email" href={`mailto:${contact.email}`}>{contact.email}</a>
      </div>
      <address>
        {contact.address.street}<br />
        {contact.address.locality}, {contact.address.region} {contact.address.postalCode}, {contact.address.country}
        <a href={`tel:${contact.phoneHref}`}>{phoneText(contact.phone)}</a>
      </address>
    </div>
  )}
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {Array.from({ length: 6 }, () => (
        <span>{cta.marquee.before} <em class="serif">{cta.marquee.emphasis}</em><i class="slash"></i></span>
      ))}
    </div>
  </div>
</section>
