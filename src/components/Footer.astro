---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import BackToTop from './BackToTop.astro';
import { site } from '../config/site';
import { footerColumns, legalNav } from '../data/navigation';
import { url } from '../utils/url';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <Logo />
        <p>{site.footerAbout}</p>
        {site.socials.length > 0 && (
          <ul class="footer__social" aria-label="Social media">
            {site.socials.map((social) => (
              <li><a href={social.href} aria-label={social.label}><Icon name={social.icon} size={16} /></a></li>
            ))}
          </ul>
        )}
      </div>
      {footerColumns.map((column) => (
        <nav aria-label={column.title}>
          <h2 class="footer__title">{column.title}</h2>
          <ul class="footer__links">
            {column.links.map((link) => <li><a href={url(link.href)}>{link.label}</a></li>)}
          </ul>
        </nav>
      ))}
      <div>
        <h2 class="footer__title">Opening Hours</h2>
        <ul class="hours">
          {site.hours.map((row) => <li><span>{row.label}</span><span>{row.hours}</span></li>)}
        </ul>
      </div>
    </div>
    <div class="footer__bottom">
      <p>Copyright &copy; {year} {site.copyright}</p>
      {legalNav.length > 0 && (
        <nav aria-label="Legal">
          {legalNav.map((link) => <a href={url(link.href)}>{link.label}</a>)}
        </nav>
      )}
      <BackToTop />
    </div>
  </div>
</footer>
