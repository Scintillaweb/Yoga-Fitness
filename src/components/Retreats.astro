---
import SectionHeading from './SectionHeading.astro';
import Button from './Button.astro';
import RetreatCard from './RetreatCard.astro';
import { retreats } from '../data/retreats';
import { retreatsSection } from '../data/home';
---

<section class="section" id="retreats" aria-labelledby="retreats-title">
  <div class="container">
    <SectionHeading id="retreats-title" title={retreatsSection.title} intro={retreatsSection.intro}>
      {retreatsSection.cta && <Button href={retreatsSection.cta.href} variant="line">{retreatsSection.cta.label}</Button>}
    </SectionHeading>
    <div class="retreats">
      {retreats.map((retreat) => <RetreatCard retreat={retreat} />)}
    </div>
  </div>
</section>
