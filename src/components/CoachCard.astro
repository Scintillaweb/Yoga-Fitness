---
import type { Coach } from '../types';
import Icon from './Icon.astro';
import { url } from '../utils/url';

interface Props {
  coach: Coach;
}

const { coach } = Astro.props;
---

<article class="coach">
  <div class="coach__media">
    <img src={url(coach.image.src)} alt={coach.image.alt} width="720" height="960" loading="lazy" decoding="async" />
    {coach.socials.length > 0 && (
      <div class="coach__social">
        {coach.socials.map((social) => (
          <a href={url(social.href)} aria-label={social.label}>
            <Icon name={social.icon} size={15} />
          </a>
        ))}
      </div>
    )}
  </div>
  <h3>{coach.name}</h3>
  <p>{coach.role}</p>
  {coach.bio && <p class="coach__bio">{coach.bio}</p>}
</article>
