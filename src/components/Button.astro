---
import type { HTMLAttributes } from 'astro/types';
import type { IconName } from '../types';
import Icon from './Icon.astro';
import { url } from '../utils/url';

interface Props extends Omit<HTMLAttributes<'a'>, 'href'> {
  href: string;
  variant?: 'dark' | 'line' | 'light' | 'glass';
  icon?: IconName;
}

const { href, variant = 'dark', icon, class: className, ...attrs } = Astro.props;
---

<a class:list={['btn', `btn--${variant}`, className]} href={url(href)} {...attrs}>
  {icon && <Icon name={icon} />}
  <slot />
</a>
