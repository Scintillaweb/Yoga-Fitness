---
import Icon from './Icon.astro';
import { focus } from '../data/home';
import { url } from '../utils/url';

const active = Math.min(Math.max(focus.initial, 0), focus.areas.length - 1);
const total = String(focus.areas.length).padStart(2, '0');
const count = (i: number) => `Focus ${String(i + 1).padStart(2, '0')} / ${total}`;
---

<section class="section focus" id="focus" aria-labelledby="focus-title" data-focus>
  <div class="container focus__grid">
    <div class="focus__head">
      <h2 id="focus-title">{focus.title}</h2>
      <p>{focus.intro}</p>
      <div class="focus__tabs" role="tablist" aria-label="Focus areas">
        {focus.areas.map((area, i) => (
          <button
            class="focus__tab"
            type="button"
            role="tab"
            id={`focus-tab-${i}`}
            aria-selected={i === active ? 'true' : 'false'}
            aria-controls="focus-panel"
            tabindex={i === active ? 0 : -1}
            data-index={i}
          >
            <span class="focus__tab-icon" aria-hidden="true"><Icon name="focus" /></span>
            <span>
              <span class="focus__tab-title">{area.title}</span>
              <span class="focus__tab-text"><span>{area.description}</span></span>
            </span>
          </button>
        ))}
      </div>
    </div>
    <div class="focus__media" id="focus-panel" role="tabpanel" aria-labelledby={`focus-tab-${active}`}>
      <img src={url(focus.image.src)} alt={focus.image.alt} width="960" height="1200" loading="lazy" decoding="async" />
      <div class="focus__frame" aria-hidden="true"></div>
      {focus.areas.map((area, i) => (
        <button
          class="hotspot"
          type="button"
          style={`--x:${area.x};--y:${area.y}`}
          aria-pressed={i === active ? 'true' : 'false'}
          aria-label={`Show focus: ${area.spot}`}
          data-index={i}
        >
          <Icon name="focus" />
        </button>
      ))}
      <div class="focus__label" aria-live="polite">
        <strong data-focus-label>{focus.areas[active].title}</strong>
        <span data-focus-count>{count(active)}</span>
      </div>
    </div>
  </div>
</section>

<script>
  // Keeps the tabs, image hotspots and label in sync.
  document.querySelectorAll<HTMLElement>('[data-focus]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const spots = [...root.querySelectorAll<HTMLButtonElement>('.hotspot')];
    const panel = root.querySelector<HTMLElement>('[role="tabpanel"]');
    const label = root.querySelector<HTMLElement>('[data-focus-label]');
    const count = root.querySelector<HTMLElement>('[data-focus-count]');
    const total = String(tabs.length).padStart(2, '0');

    const select = (index: number, moveFocus = false) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
      });
      spots.forEach((spot, i) => spot.setAttribute('aria-pressed', String(i === index)));
      panel?.setAttribute('aria-labelledby', tabs[index].id);
      if (label) label.textContent = tabs[index].querySelector('.focus__tab-title')?.textContent ?? '';
      if (count) count.textContent = `Focus ${String(index + 1).padStart(2, '0')} / ${total}`;
      if (moveFocus) tabs[index].focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (event) => {
        const keys: Record<string, number> = {
          ArrowDown: (i + 1) % tabs.length,
          ArrowRight: (i + 1) % tabs.length,
          ArrowUp: (i - 1 + tabs.length) % tabs.length,
          ArrowLeft: (i - 1 + tabs.length) % tabs.length,
          Home: 0,
          End: tabs.length - 1,
        };
        if (event.key in keys) {
          event.preventDefault();
          select(keys[event.key], true);
        }
      });
    });
    spots.forEach((spot, i) => spot.addEventListener('click', () => select(i)));
  });
</script>
