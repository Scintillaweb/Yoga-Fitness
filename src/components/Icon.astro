---
import type { IconName } from '../types';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  /** Provide a label only when the icon is the sole content conveying meaning. */
  label?: string;
}

const { name, size = 18, class: className, label } = Astro.props;
---

<svg
  width={size}
  height={size}
  class={className}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"><use href={`#i-${name}`} /></svg>
