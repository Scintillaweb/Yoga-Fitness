---
import type { Post } from '../utils/posts';
import { postMinutes } from '../utils/posts';
import { formatDate } from '../utils/format';
import { url } from '../utils/url';

interface Props {
  post: Post;
  /** Heading level for the title, so cards fit the surrounding outline. */
  as?: 'h2' | 'h3';
  showExcerpt?: boolean;
  showDate?: boolean;
}

const { post, as: Heading = 'h3', showExcerpt = false, showDate = false } = Astro.props;
const { title, description, category, image, imageAlt, pubDate } = post.data;
---

<a class="post" href={url(`/blog/${post.id}/`)}>
  <div class="post__media">
    <img src={url(image)} alt={imageAlt} width="1600" height="1000" loading="lazy" decoding="async" />
  </div>
  <div class="post__meta">
    <span>{category}</span>
    <span>{postMinutes(post)} min read</span>
    {showDate && <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>}
  </div>
  <Heading>{title}</Heading>
  {showExcerpt && <p class="post__excerpt">{description}</p>}
</a>
