---
import SectionHeading from './SectionHeading.astro';
import PricingCard from './PricingCard.astro';
import { plans, pricing } from '../data/pricing';
import { pricingSection } from '../data/home';
---

<section
  class="section section--mist"
  id="pricing"
  aria-labelledby="pricing-title"
  data-pricing
  data-currency={pricing.currency}
  data-monthly-label={pricing.monthlyLabel}
  data-yearly-label={pricing.yearlyLabel}
>
  <div class="container">
    <SectionHeading id="pricing-title" title={pricingSection.title} intro={pricingSection.intro}>
      <div class="billing" role="group" aria-label="Billing period">
        <button type="button" aria-pressed="true" data-billing="monthly">Monthly</button>
        <button type="button" aria-pressed="false" data-billing="yearly">Yearly <em>{pricing.yearlySavings}</em></button>
      </div>
    </SectionHeading>
    <div class="plans">
      {plans.map((plan) => <PricingCard plan={plan} />)}
    </div>
    <p class="sr-only" aria-live="polite" data-pricing-status></p>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-pricing]').forEach((root) => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-billing]')];
    const plans = root.querySelector<HTMLElement>('.plans');
    const status = root.querySelector<HTMLElement>('[data-pricing-status]');
    const { currency = '$', monthlyLabel = '', yearlyLabel = '' } = root.dataset;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const apply = (mode: 'monthly' | 'yearly') => {
      root.querySelectorAll<HTMLElement>('.plan__amount').forEach((amount) => {
        amount.textContent = `${currency}${amount.dataset[mode]}`;
      });
      root.querySelectorAll<HTMLElement>('.plan__per').forEach((per) => {
        per.textContent = mode === 'yearly' ? yearlyLabel : monthlyLabel;
      });
      if (status) status.textContent = mode === 'yearly' ? 'Showing yearly prices' : 'Showing monthly prices';
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        if (button.getAttribute('aria-pressed') === 'true') return;
        const mode = button.dataset.billing === 'yearly' ? 'yearly' : 'monthly';
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
        if (reduceMotion.matches || !plans) return apply(mode);
        plans.classList.add('is-switching');
        window.setTimeout(() => {
          apply(mode);
          plans.classList.remove('is-switching');
        }, 200);
      });
    });
  });
</script>
