---
import SectionHeading from './SectionHeading.astro';
import Button from './Button.astro';
import { approach } from '../data/home';
import { url } from '../utils/url';

const half = Math.ceil(approach.pillars.length / 2);
const left = approach.pillars.slice(0, half);
const right = approach.pillars.slice(half);
---

<section class="section approach" id="approach" aria-labelledby="approach-title">
  <div class="container">
    <SectionHeading id="approach-title" title={approach.title} intro={approach.intro} />
    <div class="approach__grid">
      <div>
        <ol class="pillars">
          {left.map((pillar) => (
            <li>
              <h3>{pillar.title}</h3>
              <p>{pillar.description}</p>
            </li>
          ))}
        </ol>
        <Button href={approach.cta.href} class="approach__cta">{approach.cta.label}</Button>
      </div>
      <div class="approach__media">
        <img src={url(approach.image.src)} alt={approach.image.alt} width="900" height="900" loading="lazy" decoding="async" />
      </div>
      {right.length > 0 && (
        <ol class="pillars pillars--right" start={half + 1} style={`counter-reset: pillar ${half}`}>
          {right.map((pillar) => (
            <li>
              <h3>{pillar.title}</h3>
              <p>{pillar.description}</p>
            </li>
          ))}
        </ol>
      )}
    </div>
  </div>
</section>
