---
import { site } from '../config/site';
import { absoluteUrl, url } from '../utils/url';

export interface SEOProps {
  /** Page title. Omit on the home page to use `site.seo.defaultTitle`. */
  title?: string;
  description?: string;
  /** Social image path inside `public/` (1200×630 works best). */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  /** JSON-LD objects for this page. */
  schema?: Record<string, unknown>[];
}

type Props = SEOProps;

const {
  title,
  description = site.description,
  image = site.seo.ogImage,
  imageAlt = site.seo.ogImageAlt,
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
  schema = [],
} = Astro.props;

const fullTitle = title ? `${title} ${site.seo.titleSeparator} ${site.name}` : site.seo.defaultTitle;
// Astro.url.pathname already includes `base`; normalise to a trailing slash like the sitemap.
const canonicalPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(canonicalPath, Astro.site ?? 'http://localhost:4321').href;
const ogImage = absoluteUrl(image, Astro.site);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}
<meta name="theme-color" content={site.seo.themeColor} />
<link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
<link rel="sitemap" href={url('/sitemap-index.xml')} />
<link rel="alternate" type="application/rss+xml" title={`${site.name} Journal`} href={url('/rss.xml')} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
{site.seo.twitterHandle && <meta name="twitter:site" content={site.seo.twitterHandle} />}

{schema.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
