---
import PageLayout from '../../layouts/PageLayout.astro';
import PostCard from '../../components/PostCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Newsletter from '../../components/Newsletter.astro';
import Icon from '../../components/Icon.astro';
import { getPosts, postMinutes } from '../../utils/posts';
import { formatDate } from '../../utils/format';
import { breadcrumbSchema } from '../../utils/schema';
import { url } from '../../utils/url';

const posts = await getPosts();
const [featured, ...rest] = posts;
const categories = [...new Set(posts.map((p) => p.data.category))];
---

<PageLayout
  seo={{
    title: 'Journal',
    description: 'Practical notes from our coaches on yoga, breathwork, mobility and building habits that last.',
    image: '/images/page-blog.webp',
    imageAlt: 'Two smooth stones balanced on a mossy ledge in warm light',
    schema: [breadcrumbSchema([{ name: 'Home', href: '/' }, { name: 'Blog', href: '/blog/' }], Astro.site)],
  }}
  hero={{
    image: { src: '/images/page-blog.webp', alt: '' },
    title: 'The Journal',
    words: [{ text: 'The' }, { text: 'Journal', serif: true }],
    lead: 'Practical notes from our coaches on movement, breath and building habits that last.',
    breadcrumbs: [{ name: 'Home', href: '/' }, { name: 'Blog', href: '/blog/' }],
  }}
>
  {featured ? (
    <>
      <section class="section" aria-labelledby="featured-title">
        <div class="container">
          <h2 class="sr-only" id="featured-title">Latest article</h2>
          <a class="post post-feature" href={url(`/blog/${featured.id}/`)}>
            <div class="post__media">
              <img src={url(featured.data.image)} alt={featured.data.imageAlt} width="1600" height="1000" loading="eager" decoding="async" />
            </div>
            <div>
              <div class="post__meta">
                <span>Latest</span>
                <span>{featured.data.category}</span>
                <span>{postMinutes(featured)} min read</span>
                <time datetime={featured.data.pubDate.toISOString()}>{formatDate(featured.data.pubDate)}</time>
              </div>
              <h3>{featured.data.title}</h3>
              <p class="post-feature__excerpt">{featured.data.description}</p>
              <span class="link-arrow">Read article <Icon name="arrow-up" size={14} /></span>
            </div>
          </a>
        </div>
      </section>

      {rest.length > 0 && (
        <section class="section section--mist" aria-labelledby="all-posts-title">
          <div class="container">
            <SectionHeading id="all-posts-title" title="All Articles" intro="Short, practical reads you can put to use on the mat or off it.">
              <ul class="topics" aria-label="Topics">
                {categories.map((category) => <li><span class="tag">{category}</span></li>)}
              </ul>
            </SectionHeading>
            <div class="journal">
              {rest.map((post) => <PostCard post={post} showExcerpt showDate />)}
            </div>
          </div>
        </section>
      )}
    </>
  ) : (
    <section class="section">
      <div class="container">
        <p>No articles yet — add Markdown files to <code>src/content/blog/</code>.</p>
      </div>
    </section>
  )}

  <Newsletter flush={false} />
</PageLayout>
