---
import PageLayout from '../layouts/PageLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
import { phoneText } from '../utils/format';
import { breadcrumbSchema, businessSchema } from '../utils/schema';

const { contact } = site;
const addressLine = `${contact.address.street}, ${contact.address.locality}, ${contact.address.region} ${contact.address.postalCode}, ${contact.address.country}`;
const mapUrl = `https://www.openstreetmap.org/search?query=${encodeURIComponent(addressLine)}`;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Contact', href: '/contact/' },
];
---

<PageLayout
  seo={{
    title: 'Contact',
    description: `Get in touch with ${site.name}: book a free class, ask about memberships or plan a private session.`,
    image: '/images/page-contact.webp',
    imageAlt: 'A group meditating on blankets on the beach at dusk',
    schema: [businessSchema(Astro.site), breadcrumbSchema(crumbs, Astro.site)],
  }}
  hero={{
    image: { src: '/images/page-contact.webp', alt: '' },
    title: 'Say Hello',
    words: [{ text: 'Say' }, { text: 'Hello', serif: true }],
    lead: 'Questions about classes, memberships or private sessions? Send a note or drop by the studio — we reply within one working day.',
    breadcrumbs: crumbs,
    imagePosition: 'center 60%',
  }}
>
  <section class="section" aria-labelledby="contact-details-title">
    <div class="container contact-page">
      <div>
        <h2 id="contact-details-title">Visit the Studio</h2>
        <p class="contact-page__intro">Come early for your first class and we will show you around, set you up with a mat and introduce you to your coach.</p>

        <ul class="contact-list">
          <li>
            <span class="contact-list__icon"><Icon name="mail" size={16} /></span>
            <div><span class="contact-list__label">Email</span><a class="contact-list__value" href={`mailto:${contact.email}`}>{contact.email}</a></div>
          </li>
          <li>
            <span class="contact-list__icon"><Icon name="phone" size={16} /></span>
            <div><span class="contact-list__label">Phone</span><a class="contact-list__value" href={`tel:${contact.phoneHref}`}>{phoneText(contact.phone)}</a></div>
          </li>
          <li>
            <span class="contact-list__icon"><Icon name="pin" size={16} /></span>
            <div>
              <span class="contact-list__label">Studio</span>
              <address class="contact-list__value">{contact.address.street}<br />{contact.address.locality}, {contact.address.region} {contact.address.postalCode}, {contact.address.country}</address>
            </div>
          </li>
        </ul>

        <div class="contact-block">
          <h3 class="contact-block__title">Opening Hours</h3>
          <ul class="hours">
            {site.hours.map((row) => <li><span>{row.label}</span><span>{row.hours}</span></li>)}
          </ul>
        </div>

        {site.socials.length > 0 && (
          <div class="contact-block">
            <h3 class="contact-block__title">Follow Along</h3>
            <ul class="footer__social">
              {site.socials.map((social) => (
                <li><a href={social.href} aria-label={social.label}><Icon name={social.icon} size={16} /></a></li>
              ))}
            </ul>
          </div>
        )}

        <div class="map-card">
          <span class="map-card__pin"><Icon name="pin" size={18} /></span>
          <p>{addressLine}</p>
          <a class="link-arrow" href={mapUrl} rel="noopener">Open in OpenStreetMap <Icon name="arrow-up" size={14} /></a>
        </div>
      </div>

      <ContactForm />
    </div>
  </section>

  <ContactCTA showContact={false} />
</PageLayout>
