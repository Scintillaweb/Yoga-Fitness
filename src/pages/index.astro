---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Approach from '../components/Approach.astro';
import Classes from '../components/Classes.astro';
import Focus from '../components/Focus.astro';
import Schedule from '../components/Schedule.astro';
import Coaches from '../components/Coaches.astro';
import FirstVisit from '../components/FirstVisit.astro';
import Pricing from '../components/Pricing.astro';
import Testimonials from '../components/Testimonials.astro';
import Gallery from '../components/Gallery.astro';
import Retreats from '../components/Retreats.astro';
import FAQ from '../components/FAQ.astro';
import Journal from '../components/Journal.astro';
import Newsletter from '../components/Newsletter.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { businessSchema, websiteSchema } from '../utils/schema';
---

<BaseLayout schema={[websiteSchema(Astro.site), businessSchema(Astro.site)]}>
  <Hero />
  <Approach />
  <Classes />
  <Focus />
  <Schedule />
  <Coaches />
  <FirstVisit />
  <Pricing />
  <Testimonials />
  <Gallery />
  <Retreats />
  <FAQ />
  <Journal />
  <Newsletter />
  <ContactCTA />
</BaseLayout>
