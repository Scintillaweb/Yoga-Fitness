---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Page not found" description="The page you were looking for could not be found." noindex>
  <PageHero
    full
    image={{ src: '/images/page-404.webp', alt: '' }}
    eyebrow="404"
    title="Off the Mat"
    words={[{ text: 'Off the' }, { text: 'Mat', serif: true }]}
    lead="Take a breath. This page wandered off the mat — it may have moved, or the link might be mistyped."
  >
    <div class="page-hero__actions">
      <Button href="/" variant="light">Back to Home</Button>
      <Button href="/contact" variant="glass">Contact the Studio</Button>
    </div>
  </PageHero>
</BaseLayout>
