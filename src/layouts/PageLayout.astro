---
import BaseLayout from './BaseLayout.astro';
import PageHero, { type PageHeroProps } from '../components/PageHero.astro';
import type { SEOProps } from '../components/SEO.astro';

interface Props {
  seo: SEOProps;
  hero: PageHeroProps;
}

const { seo, hero } = Astro.props;
---

<BaseLayout {...seo}>
  <PageHero {...hero}>
    <slot name="hero" />
  </PageHero>
  <slot />
</BaseLayout>
